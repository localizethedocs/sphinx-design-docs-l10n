msgstr ""

#: ../../../design_css.md:76
msgid "Output is byte-deterministic (across runs, Python versions, platforms)"
msgstr ""

#: ../../../design_css.md:76
msgid ""
"stdlib + frozen `rcssmin`, `Decimal` rounding, explicit ordering; "
"`.gitattributes` pins the artifact to LF"
msgstr ""

#: ../../../design_css.md:77
msgid "Migrations/restructurings preserve rule sets *and* cascade order"
msgstr ""

#: ../../../design_css.md:78
msgid ""
"`tools/check_css_equivalence.py` — opt-in via `SD_CSS_EQUIV_BASE=<git-ref>`, "
"diffs rule sets against an allowlist and fails on source-order inversions "
"between co-applicable rules"
msgstr ""

