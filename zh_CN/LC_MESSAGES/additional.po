#: ../../../additional.md:7
msgid "`article-info`"
msgstr ""

#: ../../../additional.md:9
msgid ""
"This directive is used to display a block of information about an article, "
"normally positioned just below the title of the article (shown below with "
"non-standard outline)."
msgstr ""

#: ../../../additional.md:12
msgid "Executable Books"
msgstr ""

#: ../../../additional.md:12
msgid "Jul 24, 2021"
msgstr ""

#: ../../../additional.md:12
msgid "5 min read"
msgstr ""

#: ../../../additional.md:0
msgid "Syntax"
msgstr ""

#: ../../../additional.md:25
msgid ""
"```{article-info}\n"
":avatar: images/ebp-logo.png\n"
":avatar-link: https://executablebooks.org/\n"
":avatar-outline: muted\n"
":author: Executable Books\n"
":date: Jul 24, 2021\n"
":read-time: 5 min read\n"
":class-container: sd-p-2 sd-outline-muted sd-rounded-1\n"
"```\n"
msgstr ""

#: ../../../additional.md:28
msgid ""
".. article-info::\n"
